# Thesis IoT Server — Environment Variables

# ── MQTT ────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ── Database ────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/thesis.db

# ── vLLM (Local GPU Server) ────────────────────────
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen3-VL-30B-A3B

# ── OpenRouter (production default, 2026-08-19) ────
OPENROUTER_API_KEY=
OPENROUTER_PLANNER_MODEL=qwen/qwen3.7-flash
OPENROUTER_ANALYSIS_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# ── Anthropic Claude (thesis benchmark backend) ────
ANTHROPIC_API_KEY=
CLAUDE_SONNET_MODEL=claude-sonnet-4-6
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001

# ── Gemini 3 Flash (thesis benchmark backend) ──────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ── Storage ─────────────────────────────────────────
UPLOAD_DIR=./data/uploads
